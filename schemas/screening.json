{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/com.example.screening.json",
  "name": "com.example.screening",
  "version": "2026-10-09",
  "title": "com.example.screening experimental extension",
  "description": "Unpublished reference contract; not an official UCP extension.",
  "$defs": {
    "dev.ucp.shopping.checkout": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/checkout.json"
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "object",
              "properties": {
                "com.example.screening": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "https://ucp.dev/schemas/common/types/actions.json#/$defs/instance"
                      },
                      {
                        "type": "object",
                        "required": [
                          "config"
                        ],
                        "properties": {
                          "config": {
                            "type": "object",
                            "required": [
                              "checkout_id",
                              "scope_hash",
                              "policy_id",
                              "provider_id",
                              "task_id"
                            ],
                            "properties": {
                              "checkout_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "scope_hash": {
                                "type": "string",
                                "minLength": 1
                              },
                              "policy_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "provider_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "task_id": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
