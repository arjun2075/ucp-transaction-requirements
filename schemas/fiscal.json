{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/com.example.fiscal_documents.json",
  "name": "com.example.fiscal_documents",
  "version": "2026-10-23",
  "title": "com.example.fiscal_documents experimental extension",
  "description": "Unpublished reference contract; not an official UCP extension.",
  "$defs": {
    "dev.ucp.shopping.checkout": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/checkout.json"
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "object",
              "properties": {
                "com.example.fiscal_documents": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "https://ucp.dev/schemas/common/types/actions.json#/$defs/instance"
                      },
                      {
                        "type": "object",
                        "required": [
                          "config"
                        ],
                        "properties": {
                          "config": {
                            "type": "object",
                            "required": [
                              "checkout_id",
                              "scope_hash",
                              "policy_id",
                              "provider_id",
                              "task_id"
                            ],
                            "properties": {
                              "checkout_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "scope_hash": {
                                "type": "string",
                                "minLength": 1
                              },
                              "policy_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "provider_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "task_id": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dev.ucp.shopping.order": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/order.json"
        },
        {
          "type": "object",
          "required": [
            "com.example.fiscal_documents"
          ],
          "properties": {
            "com.example.fiscal_documents": {
              "type": "object",
              "required": [
                "revision",
                "documents",
                "events"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 0
                },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "state",
                      "document_type",
                      "jurisdiction",
                      "media_type",
                      "content_hash",
                      "retrieval_url",
                      "issued_at"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "issued",
                          "canceled"
                        ]
                      },
                      "document_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "jurisdiction": {
                        "type": "string",
                        "minLength": 1
                      },
                      "media_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_hash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "retrieval_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "issued_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "replaces": {
                        "type": "string"
                      },
                      "invoice_number": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Business-supplied fiscal number."
                      },
                      "adjustment_id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Document-to-Order adjustment correlation; never an authorization or certification claim."
                      },
                      "preceding_documents": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "invoice_number"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "invoice_number": {
                              "type": "string",
                              "minLength": 1
                            },
                            "issue_date": {
                              "type": "string",
                              "format": "date"
                            },
                            "document_id": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "events": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "type",
                      "occurred_at",
                      "document_id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "issue",
                          "cancel",
                          "replace"
                        ]
                      },
                      "occurred_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "document_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "ucp_request": "omit"
            }
          }
        }
      ]
    }
  }
}
