{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/com.example.fiscal_documents.json",
  "name": "com.example.fiscal_documents",
  "version": "2026-10-09",
  "title": "com.example.fiscal_documents experimental extension",
  "description": "Unpublished reference contract; not an official UCP extension.",
  "$defs": {
    "dev.ucp.shopping.checkout": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/checkout.json"
        },
        {
          "type": "object",
          "properties": {
            "actions": {
              "type": "object",
              "properties": {
                "com.example.fiscal_documents": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "https://ucp.dev/schemas/common/types/actions.json#/$defs/instance"
                      },
                      {
                        "type": "object",
                        "required": [
                          "config"
                        ],
                        "properties": {
                          "config": {
                            "type": "object",
                            "required": [
                              "checkout_id",
                              "scope_hash",
                              "policy_id",
                              "provider_id",
                              "task_id"
                            ],
                            "properties": {
                              "checkout_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "scope_hash": {
                                "type": "string",
                                "minLength": 1
                              },
                              "policy_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "provider_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "task_id": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "dev.ucp.shopping.order": {
      "allOf": [
        {
          "$ref": "https://ucp.dev/schemas/shopping/order.json"
        },
        {
          "type": "object",
          "required": [
            "com.example.fiscal_documents"
          ],
          "properties": {
            "com.example.fiscal_documents": {
              "type": "object",
              "required": [
                "revision",
                "documents"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "state",
                      "format",
                      "content_hash",
                      "download_url"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "type": "string",
                        "enum": [
                          "certified",
                          "canceled"
                        ]
                      },
                      "format": {
                        "type": "string"
                      },
                      "content_hash": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "download_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "replaces": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "ucp_request": "omit"
            }
          }
        }
      ]
    }
  }
}
